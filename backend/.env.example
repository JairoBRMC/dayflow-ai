DATABASE_URL=postgresql://dayflow_user:dayflow_pass@localhost:5433/dayflow_db
# Base de datos aparte para pytest (servicio db_test en docker-compose.yml) -- nunca
# la de desarrollo. conftest.py le aplica las migraciones de Alembic automáticamente.
TEST_DATABASE_URL=postgresql://dayflow_user:dayflow_pass@localhost:5434/dayflow_test_db
# Genera un valor propio: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-un-valor-secreto-generado

# Clave de Groq para el endpoint de chat (POST /conversations/{id}/chat).
# Consíguela en https://console.groq.com/keys -- solo hace falta para ese endpoint,
# el resto de la API funciona sin ella.
GROQ_API_KEY=cambia-esto-por-tu-clave-de-groq
# Opcional: por defecto usa openai/gpt-oss-20b. Lista de modelos disponibles para tu
# clave: client.models.list() (ver backend/groq_client.py).
# GROQ_MODEL=openai/gpt-oss-20b